# Copy to .env for local runs. On the host, set these as secrets instead.
SEC_USER_AGENT=Your Name your.email@example.com
MSC_DASH_PASSWORD=choose-a-long-password
# Optional:
# MSC_WATCHLIST=AAPL,MSFT,NVDA
# ALPACA_KEY_ID=...        (only for python -m msc stock-prices, free Alpaca account)
# ALPACA_SECRET_KEY=...
# MSC_STOCK_PRICE_DIR=stock_prices
# MSC_EARNINGS_TICKERS=AAPL,MSFT,NVDA   (earnings_drift universe; default: the watchlist)
# MSC_SIGNALS=sec_filings,prediction_markets,social,journals_news,price_anchor
# MSC_RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml
# MSC_REDDIT_SUBS=stocks,investing
# MSC_PM_RULES=[{"match":"recession","bullish_if":"no"}]
# MSC_PM_VENUES=polymarket,kalshi
# MSC_RUN_HOUR_UTC=22
# MSC_RUN_MINUTE_UTC=30
# MSC_EXTRA_MODULES=my_signals.paid_news
